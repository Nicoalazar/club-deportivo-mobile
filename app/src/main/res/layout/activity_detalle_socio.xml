<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <!-- BARRA SUPERIOR CON BOTÓN VOLVER -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:cardBackgroundColor="@color/colorPrimary"
        app:cardCornerRadius="8dp"
        android:layout_margin="2dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <TextView
                android:id="@+id/btnVolverDetalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="←"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNombreTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/btnVolverDetalle"
                android:layout_marginStart="16dp"
                android:text="Juan Pérez"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <!-- CONTENIDO SCROLLABLE -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">


            <!-- CARNET FÍSICO   -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardCarnet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#1B4F8A"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <!-- Avatar Redondo (Placeholder de foto) -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_gravity="center_vertical"
                        app:cardCornerRadius="40dp"
                        app:cardBackgroundColor="@color/colorSecondary">
                        <TextView
                            android:id="@+id/tvAvatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="JP"
                            android:textColor="@color/white"
                            android:textSize="24sp"
                            android:textStyle="bold" />
                    </androidx.cardview.widget.CardView>

                    <!-- Datos internos del Carnet -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:id="@+id/tvCarnetNombre"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="JUAN PÉREZ"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCarnetDni"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DNI: 38.123.456"
                            android:textColor="#E0E0E0"
                            android:textSize="14sp"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:id="@+id/tvCarnetCategoria"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Categoría: Socio"
                            android:textColor="#E0E0E0"
                            android:textSize="14sp"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:id="@+id/tvNumCarnet"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Carnet N° 00042"
                            android:textColor="#E0E0E0"
                            android:textSize="14sp"
                            android:layout_marginTop="2dp" />

                        <!-- Estado Al día / Vencido -->
                        <TextView
                            android:id="@+id/tvBadgeEstado"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="✓ Cuota al día"
                            android:textColor="#00FF00"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:background="#22000000"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- DATOS PERSONALES -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Datos personales"
                android:textColor="@color/colorPrimary"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="8dp">
                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">
                    <TableRow android:paddingBottom="8dp">
                        <TextView android:text="DNI:" android:textColor="@color/colorTextMuted" android:layout_width="100dp" />
                        <TextView android:id="@+id/tvDniDetalle" android:text="38.123.456" android:textStyle="bold" />
                    </TableRow>
                    <TableRow android:paddingBottom="8dp">
                        <TextView android:text="Email:" android:textColor="@color/colorTextMuted" />
                        <TextView android:id="@+id/tvEmailDetalle" android:text="juan@mail.com" android:textStyle="bold" />
                    </TableRow>
                    <TableRow android:paddingBottom="8dp">
                        <TextView android:text="Teléfono:" android:textColor="@color/colorTextMuted" />
                        <TextView android:id="@+id/tvTelefonoDetalle" android:text="11-4567-8901" android:textStyle="bold" />
                    </TableRow>
                    <TableRow>
                        <TextView android:text="Apto físico:" android:textColor="@color/colorTextMuted" />
                        <TextView android:text="Vence: 01/09/2026" android:textStyle="bold" />
                    </TableRow>
                </TableLayout>
            </androidx.cardview.widget.CardView>

            <!-- HISTORIAL DE PAGOS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Últimos pagos"
                android:textColor="@color/colorPrimary"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="6dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp">
                    <TextView android:id="@+id/txtF1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10/04/2026" android:textColor="@color/colorTextMuted" />
                    <TextView android:layout_below="@id/txtF1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Efectivo" android:textColor="@color/colorTextHint" android:textSize="11sp" />
                    <TextView android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$3.500" android:textColor="@color/colorStatusOk" android:textStyle="bold" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="6dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp">
                    <TextView android:id="@+id/txtF2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10/03/2026" android:textColor="@color/colorTextMuted" />
                    <TextView android:layout_below="@id/txtF2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Transferencia" android:textColor="@color/colorTextHint" android:textSize="11sp" />
                    <TextView android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$3.500" android:textColor="@color/colorStatusOk" android:textStyle="bold" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="6dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp">
                    <TextView android:id="@+id/txtF3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10/02/2026" android:textColor="@color/colorTextMuted" />
                    <TextView android:layout_below="@id/txtF3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Efectivo" android:textColor="@color/colorTextHint" android:textSize="11sp" />
                    <TextView android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$3.200" android:textColor="@color/colorStatusOk" android:textStyle="bold" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>


    <!-- SECCIÓN DE ACCIONES (BOTONES) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp">

        <!-- Botón Principal: Registrar Pago o Cobrar Actividad -->
        <Button
            android:id="@+id/btnAccionPrincipal"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="REGISTRAR PAGO"
            android:backgroundTint="@color/colorPrimary"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Fila Horizontal para Editar y Dar de Baja -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Botón Editar Datos -->
            <Button
                android:id="@+id/btnEditar"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="EDITAR"
                style="?android:attr/buttonStyleToggle"
                android:textColor="@color/colorPrimary"
                android:layout_marginEnd="4dp" />

            <!-- Botón Dar de Baja (En Rojo para alertar peligro) -->
            <Button
                android:id="@+id/btnDarDeBaja"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="DAR DE BAJA"
                android:backgroundTint="#D32F2F"
                android:textColor="@color/white"
                android:layout_marginStart="4dp" />

        </LinearLayout>
    </LinearLayout>